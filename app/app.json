{
  "expo": {
    "name": "ProductivityApp",
    "slug": "productivity-app",
    "owner": "jerodev",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "productivityapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jerodev.productivityapp",
      "versionCode": 1,
      "permissions": [
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "productivityapp"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#E6F4FE"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-calendar",
        {
          "calendarPermission": "Productivity needs calendar access to import events and add your tasks."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4c2e8f06-25c6-4767-aa8e-5bdabdc70cdf"
      }
    }
  }
}
