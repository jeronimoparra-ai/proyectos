# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter (IA)
OPENROUTER_API_KEY=your-openrouter-key

# Brave Search API
BRAVE_SEARCH_API_KEY=your-brave-search-key

# Google Calendar API
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:8081
FRONTEND_URL=http://localhost:8081

# Expo Push Notifications (optional but recommended for production)
EXPO_ACCESS_TOKEN=your-expo-access-token

# Reminder worker (T5)
# Batch of due reminders the worker attempts per cycle (bounded sends).
REMINDER_BATCH_MAX=25
# How long a worker's reservation (claimed_at) lasts before it expires and
# another worker can recover it (crash recovery).
REMINDER_CLAIM_TTL_MS=300000
# Max delivery retries before a reminder is marked processed (not re-forwarded).
REMINDER_RETRY_MAX_ATTEMPTS=3
# Seconds between worker cycles.
REMINDER_CHECK_INTERVAL_MS=60000
# Per-request timeout for fetch to Expo.
EXPO_REQUEST_TIMEOUT_MS=15000

# Exact registered web redirect (including trailing slash); no wildcards/query/hash.
GOOGLE_REDIRECT_URI=http://localhost:8081/
